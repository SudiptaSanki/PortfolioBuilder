{
  "name": "portfolio-builder",
  "version": "2.0.0",
  "private": true,
  "description": "Provider-Independent Open-Source Portfolio Directory and Showcase",
  "scripts": {
    "validate": "node scripts/validate-templates.js",
    "validate:urls": "node scripts/validate-urls.js",
    "test:phase3": "node scripts/test-phase3-validation.js",
    "generate:festival": "node scripts/festival/generate.js",
    "catalog:generate": "node scripts/generate-catalog.js",
    "hub": "node scripts/generate-preview-hub.js",
    "showcase:dev": "npm --prefix showcase run dev",
    "showcase:build": "npm --prefix showcase run build",
    "build": "node scripts/generate-catalog.js && npm --prefix showcase run build"
  },
  "keywords": [
    "portfolio",
    "templates",
    "showcase",
    "open-source"
  ],
  "author": "Sudipta Sanki",
  "license": "MIT"
}
